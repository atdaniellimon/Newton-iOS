{
  "name": "newton-desktop",
  "version": "0.1.0",
  "description": "Newton AI Desktop Application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build:dir": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "install:app": "npm run build:dir && rm -rf /Applications/Newton.app && cp -R dist/mac/Newton.app /Applications/ && echo 'Newton.app instalada exitosamente en /Applications'",
    "build-n-install": "npm run install:app",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.daniellimon.newton",
    "productName": "Newton",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/**/*.{html,css,js}",
      "src/services/**/*",
      "src/assets/**/*",
      "package.json",
      "node_modules/three/build/three.module.js",
      "node_modules/marked/lib/marked.esm.js",
      "node_modules/framework7-icons/**/*"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "src/assets/icon.icns"
    }
  },
  "keywords": [
    "electron",
    "ai",
    "newton"
  ],
  "author": "Daniel Limón",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "framework7-icons": "^5.0.5",
    "marked": "^18.0.13",
    "three": "^0.186.0"
  }
}
