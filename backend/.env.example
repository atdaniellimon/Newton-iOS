# Newton Proxy — Environment Variables
# Copy this to .env and fill in your values

# NWTN upstream API base URL (include /nwtn suffix)
NWTN_UPSTREAM=https://api.newton.daniellimon.uk/nwtn

# NWTN admin token (from your NWTN server's AIENDPOINTS_ADMIN_KEY)
NWTN_ADMIN_TOKEN=ntwn-REPLACE_WITH_YOUR_ADMIN_TOKEN

# Local SQLite database path
DB_PATH=./users.db

# Port to run the proxy on (auth.newton.daniellimon.uk → localhost:6742)
PORT=6742
